@model IEnumerable<Docente>
@{ ViewData["Title"] = "Docentes"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="page-title mb-0">Administrar Docentes</h3>
        <span class="text-muted small">@Model.Count() docentes registrados</span>
    </div>
    <a class="btn btn-success" asp-action="Create"><i class="bi bi-plus-lg"></i> Agregar docente</a>
</div>
<div class="card-table">
<table class="table table-hover align-middle mb-0">
    <thead class="table-light">
        <tr><th>Nombre</th><th>Correo</th><th>Especialidad</th><th>Cursos asignados</th><th class="text-end">Acciones</th></tr>
    </thead>
    <tbody>
    @foreach (var d in Model)
    {
        <tr>
            <td class="fw-semibold">@d.NombreCompleto</td>
            <td>@d.Correo</td>
            <td>@d.Especialidad</td>
            <td>@(d.Cursos.Any() ? string.Join(", ", d.Cursos.Select(c => c.Codigo)) : "—")</td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@d.Id">Editar</a>
                <form asp-action="Delete" asp-route-id="@d.Id" method="post" class="d-inline"
                      onsubmit="return confirm('¿Eliminar al docente @(d.NombreCompleto)?');">
                    <button class="btn btn-sm btn-outline-danger">Eliminar</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
<p class="text-muted small mt-2">Para asignar un docente a un curso, edite el curso en "Gestión de Cursos".</p>
