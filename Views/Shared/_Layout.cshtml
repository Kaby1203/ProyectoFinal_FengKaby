@{
    var esAdmin = User.IsInRole("Administrador");
    var esEstudiante = User.IsInRole("Estudiante");
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    var accion = ViewContext.RouteData.Values["action"]?.ToString();
    string Activo(string c, string a = null) =>
        controlador == c && (a == null || accion == a) ? "active" : "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UniMatrícula</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
<div class="app-shell">
    <aside class="sidebar">
        <div class="brand"><i class="bi bi-mortarboard-fill"></i> UniMatrícula</div>
        <div class="brand-sub">@(esAdmin ? "Administración" : "Portal estudiantil")</div>
        <nav class="nav flex-column mt-3">
            <a class="nav-link @Activo("Home")" asp-controller="Home" asp-action="Index"><i class="bi bi-house"></i> Inicio</a>
            @if (esEstudiante)
            {
                <a class="nav-link @Activo("Carreras")" asp-controller="Carreras" asp-action="Index"><i class="bi bi-journal-bookmark"></i> Carreras</a>
                <a class="nav-link @Activo("Matricula", "Index")" asp-controller="Matricula" asp-action="Index"><i class="bi bi-journal-check"></i> Matricular cursos</a>
                <a class="nav-link @Activo("Matricula", "MisCursos")" asp-controller="Matricula" asp-action="MisCursos"><i class="bi bi-book"></i> Mis cursos</a>
            }
            @if (esAdmin)
            {
                <a class="nav-link @Activo("Carreras")" asp-controller="Carreras" asp-action="Index"><i class="bi bi-journal-bookmark"></i> Gestión de Carreras</a>
                <a class="nav-link @Activo("Cursos")" asp-controller="Cursos" asp-action="Index"><i class="bi bi-book"></i> Gestión de Cursos</a>
                <a class="nav-link @Activo("Docentes")" asp-controller="Docentes" asp-action="Index"><i class="bi bi-person-badge"></i> Gestión de Docentes</a>
            }
        </nav>
    </aside>
    <div class="content-area">
        <header class="topbar">
            <span class="text-muted small">@User.Identity?.Name</span>
            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline ms-3">
                <button class="btn btn-sm btn-outline-secondary"><i class="bi bi-box-arrow-right"></i> Salir</button>
            </form>
        </header>
        <main class="p-4">
            @if (TempData["Ok"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">@TempData["Ok"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
            }
            @RenderBody()
        </main>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
