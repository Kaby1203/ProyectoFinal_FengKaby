@{ ViewData["Title"] = "Panel de administración"; }
<h3 class="page-title">Panel de Administración</h3>
<p class="text-muted">Resumen general del sistema de matrícula</p>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg"><div class="stat-card"><div class="text-muted small">Estudiantes</div><div class="num">@ViewBag.TotalEstudiantes</div></div></div>
    <div class="col-6 col-lg"><div class="stat-card"><div class="text-muted small">Carreras</div><div class="num">@ViewBag.TotalCarreras</div></div></div>
    <div class="col-6 col-lg"><div class="stat-card"><div class="text-muted small">Cursos</div><div class="num">@ViewBag.TotalCursos</div></div></div>
    <div class="col-6 col-lg"><div class="stat-card"><div class="text-muted small">Docentes</div><div class="num">@ViewBag.TotalDocentes</div></div></div>
    <div class="col-6 col-lg"><div class="stat-card"><div class="text-muted small">Matrículas activas</div><div class="num">@ViewBag.TotalMatriculas</div></div></div>
</div>

<div class="card-table p-3">
    <h6 class="fw-bold">Acciones rápidas</h6>
    <a class="btn btn-primary me-2" asp-controller="Carreras" asp-action="Create">Nueva carrera</a>
    <a class="btn btn-outline-primary me-2" asp-controller="Cursos" asp-action="Create">Nuevo curso</a>
    <a class="btn btn-outline-primary" asp-controller="Docentes" asp-action="Create">Nuevo docente</a>
</div>
