@model Estudiante
@{ ViewData["Title"] = "Inicio"; }
<h3 class="page-title">Bienvenido, @Model.NombreCompleto</h3>
<p class="text-muted">Expediente @Model.Expediente · Periodo académico 2026-III</p>

<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="stat-card"><div class="text-muted small">Carrera</div><div class="fw-semibold mt-1">@Model.Carrera.Nombre</div></div></div>
    <div class="col-md-4"><div class="stat-card"><div class="text-muted small">Cursos matriculados</div><div class="num">@ViewBag.CursosMatriculados</div></div></div>
    <div class="col-md-4"><div class="stat-card"><div class="text-muted small">Créditos matriculados</div><div class="num">@ViewBag.Creditos</div></div></div>
</div>

<div class="hero">
    <h4 class="fw-bold">Construye tu próximo semestre</h4>
    <p class="mb-3">Explora la oferta académica de tu carrera y selecciona los cursos que deseas matricular.</p>
    <a class="btn btn-light" asp-controller="Matricula" asp-action="Index">Matricular cursos</a>
</div>
