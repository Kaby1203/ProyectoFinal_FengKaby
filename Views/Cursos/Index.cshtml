@model IEnumerable<Curso>
@{ ViewData["Title"] = "Cursos"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="page-title mb-0">Administrar Cursos</h3>
        <span class="text-muted small">@Model.Count() cursos registrados en el periodo actual</span>
    </div>
    <a class="btn btn-success" asp-action="Create"><i class="bi bi-plus-lg"></i> Agregar nuevo curso</a>
</div>
<div class="card-table">
<table class="table table-hover align-middle mb-0">
    <thead class="table-light">
        <tr><th>Código</th><th>Nombre</th><th>Carrera</th><th class="text-center">Créditos</th><th class="text-center">Cupos</th><th>Docente</th><th class="text-end">Acciones</th></tr>
    </thead>
    <tbody>
    @foreach (var c in Model)
    {
        var inscritos = c.Matriculas.Count(m => m.Estado == "Activa");
        <tr>
            <td class="fw-semibold">@c.Codigo</td>
            <td>@c.Nombre</td>
            <td>@c.Carrera?.Nombre</td>
            <td class="text-center">@c.Creditos</td>
            <td class="text-center">@inscritos / @c.CuposMaximos</td>
            <td>@(c.Docente?.NombreCompleto ?? "Sin asignar")</td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@c.Id">Editar</a>
                <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline"
                      onsubmit="return confirm('¿Eliminar el curso @(c.Nombre)?');">
                    <button class="btn btn-sm btn-outline-danger">Eliminar</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
