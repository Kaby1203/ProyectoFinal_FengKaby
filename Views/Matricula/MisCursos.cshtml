@model IEnumerable<Matricula>
@{ ViewData["Title"] = "Mis cursos"; }
<h3 class="page-title">Mis cursos matriculados</h3>
<p class="text-muted">Total de créditos: <strong>@Model.Sum(m => m.Curso.Creditos)</strong></p>

<div class="card-table">
<table class="table align-middle mb-0">
    <thead class="table-light">
        <tr><th>Código</th><th>Curso</th><th class="text-center">Créditos</th><th>Docente</th><th>Fecha</th><th class="text-end"></th></tr>
    </thead>
    <tbody>
    @foreach (var m in Model)
    {
        <tr>
            <td class="fw-semibold">@m.Curso.Codigo</td>
            <td>@m.Curso.Nombre</td>
            <td class="text-center">@m.Curso.Creditos</td>
            <td>@(m.Curso.Docente?.NombreCompleto ?? "Por asignar")</td>
            <td>@m.Fecha.ToString("dd/MM/yyyy")</td>
            <td class="text-end">
                <form asp-action="Cancelar" asp-route-id="@m.Id" method="post"
                      onsubmit="return confirm('¿Cancelar la matrícula de este curso?');">
                    <button class="btn btn-sm btn-outline-danger">Cancelar</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
@if (!Model.Any())
{
    <p class="text-muted mt-3">Todavía no ha matriculado cursos. <a asp-action="Index">Ir a matrícula</a></p>
}
