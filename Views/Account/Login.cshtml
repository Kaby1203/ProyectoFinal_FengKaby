@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_AuthLayout";
}
<h4 class="text-center fw-bold">Bienvenido de nuevo</h4>
<p class="text-center text-muted small">Ingresa tus credenciales para continuar</p>

<form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
    <div class="mb-3">
        <label asp-for="Correo" class="form-label"></label>
        <input asp-for="Correo" class="form-control" placeholder="nombre@unimatricula.com" />
        <span asp-validation-for="Correo" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>
    <div class="form-check mb-3">
        <input asp-for="Recordarme" class="form-check-input" />
        <label asp-for="Recordarme" class="form-check-label"></label>
    </div>
    <button class="btn btn-primary w-100">Iniciar sesión</button>
</form>
<p class="text-center small mt-3 mb-0">¿No tienes cuenta? <a asp-action="Register">Regístrate aquí</a></p>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
